# Kopieren nach .env und ausfüllen. .env gehört nie ins Repo.

# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=

# --- Datenbank (Compose baut daraus DATABASE_URL) ---
POSTGRES_USER=ggbot
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=ggbot

# --- Bot ---
DEFAULT_LOCALE=de          # de | en, Startsprache neuer Server
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | console
# DEV_GUILD_ID=            # Slash-Commands sofort auf dieser Test-Guild statt global
# SHARD_COUNT=             # leer = automatisch, ein Prozess
# SHARD_IDS=               # z. B. 0,1 (nur bei mehreren Prozessen)

# --- Web ---
WEB_PORT=8080              # Port, auf dem das Dashboard im Netz erreichbar ist
