# Kopieren nach .env und ausfüllen. .env gehört nie ins Repo.

# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=

# --- Datenbank (Compose baut daraus DATABASE_URL) ---
POSTGRES_USER=ggbot
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=ggbot

# --- Bot ---
DEFAULT_LOCALE=de          # de | en, Startsprache neuer Server
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | console
# DEV_GUILD_ID=            # Slash-Commands sofort auf dieser Test-Guild statt global
# SHARD_COUNT=             # leer = automatisch, ein Prozess
# SHARD_IDS=               # z. B. 0,1 (nur bei mehreren Prozessen)

# ENABLE_MESSAGE_CONTENT_INTENT=false   # true nur nach Freigabe im Developer Portal (Automod-Nachrichtenregeln, Purge: contains/links)
# ENABLE_MEMBERS_INTENT=false           # true nur nach Freigabe im Developer Portal (Anti-Raid, Konto-Alter)

# TWITCH_CLIENT_ID=                    # Twitch-Benachrichtigungen: App auf dev.twitch.tv anlegen (Client-ID und -Secret)
# TWITCH_CLIENT_SECRET=

# MESSAGE_CACHE_SIZE=5000              # Nachrichten im Speicher (Event-Log zeigt nur daraus den Inhalt)

# --- Web ---
WEB_PORT=8080              # Port, auf dem das Dashboard im Netz erreichbar ist

# --- Dashboard (Discord-Login) ---
# DISCORD_CLIENT_ID=                   # Anwendungs-ID aus dem Developer Portal (OAuth2 → General)
# DISCORD_CLIENT_SECRET=               # Client Secret; Redirect im Portal eintragen: <DASHBOARD_URL>/api/auth/callback
# DASHBOARD_URL=http://localhost:8080  # öffentliche Adresse des Dashboards, ohne Slash am Ende
# SESSION_SECRET=                      # mind. 32 Zeichen, z. B. `openssl rand -hex 32`
# METRICS_TOKEN=                       # schaltet /metrics (Prometheus) ein; im Compose-Netz auf api:8000 erreichbar, nicht über nginx
# PROXY_HOPS=1                         # Proxys vor der API: 1 = nur der nginx aus Compose, 2 = zusätzlich dein eigener Reverse Proxy
# COOKIE_SECURE=true                   # nur bei reinem http (lokale Entwicklung) auf false
