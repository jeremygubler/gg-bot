  "moderation": {
    "schema": {
      "$defs": {
        "EscalationRule": {
          "description": "\"Bei genau `warns` aktiven Verwarnungen führt der Bot `action` aus\".",
          "properties": {
            "warns": {
              "maximum": 100,
              "minimum": 1,
              "title": "Warns",
              "type": "integer"
            },
            "action": {
              "enum": [
                "timeout",
                "kick",
                "ban",
                "tempban"
              ],
              "title": "Action",
              "type": "string"
            },
            "duration_seconds": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Duration Seconds"
            }
          },
          "required": [
            "warns",
            "action"
          ],
          "title": "EscalationRule",
          "type": "object"
        }
      },
      "properties": {
        "dm_on_action": {
          "default": true,
          "title": "Dm On Action",
          "type": "boolean"
        },
        "warn_expiry_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warn Expiry Days"
        },
        "escalation": {
          "items": {
            "$ref": "#/$defs/EscalationRule"
          },
          "maxItems": 20,
          "title": "Escalation",
          "type": "array"
        }
      },
      "title": "ModerationSettings",
      "type": "object"
    },
    "defaults": {
      "dm_on_action": true,
      "warn_expiry_days": null,
      "escalation": []
    }
  },
