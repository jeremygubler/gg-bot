{
  "general": {
    "schema": {
      "properties": {
        "embed_color": {
          "default": 5793266,
          "maximum": 16777215,
          "minimum": 0,
          "title": "Embed Color",
          "type": "integer",
          "x-widget": "color"
        }
      },
      "title": "GeneralSettings",
      "type": "object"
    },
    "defaults": {
      "embed_color": 5793266
    }
